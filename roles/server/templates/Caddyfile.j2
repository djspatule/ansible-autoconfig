{
    # Keep admin disabled in this learning setup so the proxy has one obvious
    # configuration source: the Caddyfile managed by Ansible.
    admin off
    # Always emit the access log so the fail2ban caddy-basic-auth jail has a
    # file to tail. Per-site basic_auth blocks override the output format to
    # JSON, but the file itself is created here regardless of traffic shape.
    log {
        output file {{ server_reverse_proxy_access_log }}
    }
{% if not server_reverse_proxy_auto_https %}
    # Stay on plain HTTP for VM and LAN tests. Real public domains can switch
    # this off and let Caddy manage certificates automatically.
    auto_https off
{% endif %}
}

{% for site in server_reverse_proxy_sites %}
{% if server_reverse_proxy_auto_https %}
{{ site.hostname }} {
{% else %}
# Use explicit http:// listeners when testing on a high port, otherwise Caddy
# may treat the hostname as an HTTPS site and reset plain HTTP requests.
http://{{ site.hostname }} {
{% endif %}
{% if site.redirect_to is defined %}
    # Redirect non-canonical hosts in the proxy itself so applications can keep
    # a single public URL and avoid duplicate host handling.
    redir {{ site.redirect_to }}{{ '{uri}' }} {{ site.redirect_status | default(308) }}
{% else %}
{% if server_reverse_proxy_hsts_enabled and server_reverse_proxy_auto_https %}
    # Tell browsers to stick to HTTPS for this host (HSTS).
    header Strict-Transport-Security "max-age={{ server_reverse_proxy_hsts_max_age }}"
{% endif %}
{% if site.basic_auth | default(false) %}
    log {
        output file {{ server_reverse_proxy_access_log }}
        format json
    }

    # Protect admin-style dashboards exposed through public DNS.
{% if site.basic_auth_except_paths | default([]) %}
    # ...except these paths, which carry their own credential in the URL and
    # are called by machines that cannot present basic auth. Uptime Kuma's push
    # endpoint is the case here: the token in the path IS the authentication,
    # and the dead-man's switch has no way to send a basic_auth header.
    @needs_auth not path {{ site.basic_auth_except_paths | join(' ') }}
    basic_auth @needs_auth {
        {{ server_reverse_proxy_basic_auth_hashes[site.hostname].user }} {{ server_reverse_proxy_basic_auth_hashes[site.hostname].hash }}
    }
{% else %}
    basic_auth {
        {{ server_reverse_proxy_basic_auth_hashes[site.hostname].user }} {{ server_reverse_proxy_basic_auth_hashes[site.hostname].hash }}
    }
{% endif %}
{% endif %}
{% if site.upstream_tls_insecure_skip_verify | default(false) %}
    reverse_proxy {{ site.upstream }} {
        transport http {
            tls_insecure_skip_verify
        }
    }
{% else %}
    reverse_proxy {{ site.upstream }}
{% endif %}
{% endif %}
}

{% endfor %}
