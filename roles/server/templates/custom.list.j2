# Pi-hole local DNS records — managed by ansible-autoconfig.
# This file is /etc/pihole/custom.list inside the container; dnsmasq reloads
# it on every Pi-hole restart, so changing an entry here and re-running
# ansible-pull is enough to propagate it to every LAN client.
#
# Source of truth: host_vars/serverannah -> pihole_custom_dns_records.
# Do not edit by hand — the next ansible-pull will overwrite.
{% for record in pihole_custom_dns_records %}
{{ record.ip | ansible.utils.ipaddr }}	{{ record.name }}
{% endfor %}
