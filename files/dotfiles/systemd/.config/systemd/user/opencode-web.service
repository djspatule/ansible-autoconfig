[Unit]
Description=opencode web UI (LAN-bind on {{ opencode_lan_ip }}:{{ opencode_port }})
Documentation=https://opencode.ai/docs/web
# Server-side state lives in the user's XDG data home, so the unit must run as
# the desktop user (root in a user unit breaks DBus / XDG_RUNTIME_DIR lookups
# and opencode then refuses to write its session store).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind explicitly to the LAN IP so the dashboard is reachable from Caddy
# (192.168.1.100:4096) but never accidentally published on 0.0.0.0. The Caddy
# basic_auth front-door is the primary gate; the EnvironmentFile below adds
# OPENCODE_SERVER_PASSWORD so a stray LAN device cannot poke at the API
# directly.
EnvironmentFile=%h/.opencode-server-password
ExecStart={{ opencode_binary }} web --hostname {{ opencode_lan_ip }} --port {{ opencode_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
