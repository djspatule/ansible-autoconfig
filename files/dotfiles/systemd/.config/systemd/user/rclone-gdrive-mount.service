[Unit]
Description=rclone mount of {{ rclone_remote }} into %h
Documentation=https://rclone.org/commands/rclone_mount/
# rclone exits immediately if the remote has never been authorised. Allow that
# on first-run so a fresh `rclone config` flow does not crash-loop the unit;
# the next start (after the user finishes `rclone config`) succeeds.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# notify requires rclone >= 1.55; the distro package is newer than that on
# every supported family, so simple is sufficient. ExecStartPre creates the
# mount point so the user's first run never errors on a missing directory.
ExecStartPre=/usr/bin/install -d -m 0755 {{ rclone_mount_point }}
# Double-quote both the remote name and the mount point so the space inside
# "Google Drive Perso" survives systemd's word-splitting.
ExecStart=/usr/bin/rclone mount \
    --cache-dir %h/.cache/rclone \
    {{ rclone_remote_flags | join(' ') }} \
    "{{ rclone_remote }}" "{{ rclone_mount_point }}"
ExecStop=/usr/bin/fusermount3 -uz "{{ rclone_mount_point }}"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
